# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here
MONGO_DATABASE=streamflow

# Backend Configuration
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://admin:your_secure_mongo_password_here@mongodb:27017/streamflow?authSource=admin
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_at_least_32_characters
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# SSL Configuration (for production)
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# Optional: External services
# REDIS_URL=redis://redis:6379
# EMAIL_SERVICE=your_email_service
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_email_password
